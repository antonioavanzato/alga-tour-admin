# Шаблон секретов для деплоя. Скопируйте в .deploy.env и впишите реальные значения.
#   cp .deploy.env.example .deploy.env
# Файл .deploy.env в .gitignore — он НИКОГДА не попадёт в репозиторий.

# Секретный ключ формы (должен совпадать с SECRET_KEY в JS-коде формы на сайте)
INTAKE_SECRET=change-me

# Telegram-бот (получить у @BotFather) и ID канала/чата для уведомлений
BOT_TOKEN=000000000:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CHAT_IDS=-1000000000000

# Админы: почты через запятую и общий пароль входа
ADMIN_EMAILS=admin1@example.com,admin2@example.com
ADMIN_PASSWORD=change-me

# Секрет подписи токенов и ключи Web Push — сгенерировать: node gen-keys.js
JWT_SECRET=change-me
VAPID_PUBLIC_KEY=change-me
VAPID_PRIVATE_KEY=change-me
VAPID_SUBJECT=mailto:admin@example.com
